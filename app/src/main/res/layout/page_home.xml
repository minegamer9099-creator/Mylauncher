<?xml version="1.0" encoding="utf-8"?>
<!-- Ek home screen page. Date + glass clock + widgets sirf pehle page pe dikhte hain. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Clock header: "centered" (bada, accent digit) ya "compact" (ColorOS default: left clock + right date) -->
    <FrameLayout
        android:id="@+id/clockHeader"
        android:layout_width="match_parent"
        android:layout_height="150dp">

        <LinearLayout
            android:id="@+id/clockCentered"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="8dp">

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="d MMM  EEE"
                android:format24Hour="d MMM  EEE"
                android:shadowColor="#40000000"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:textColor="#E6FFFFFF"
                android:textSize="15sp" />

            <com.example.mylauncher.GlassClockView
                android:id="@+id/glassClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/clockCompact"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="26dp"
            android:paddingTop="8dp"
            android:paddingEnd="26dp"
            android:visibility="gone">

            <com.example.mylauncher.GlassClockView
                android:id="@+id/glassClockCompact"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="vertical">

                <TextClock
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:format12Hour="d MMM"
                    android:format24Hour="d MMM"
                    android:shadowColor="#40000000"
                    android:shadowDy="1"
                    android:shadowRadius="3"
                    android:textColor="#E6FFFFFF"
                    android:textSize="14sp" />

                <TextClock
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:format12Hour="EEE"
                    android:format24Hour="EEE"
                    android:shadowColor="#40000000"
                    android:shadowDy="1"
                    android:shadowRadius="3"
                    android:textColor="#E6FFFFFF"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Widgets: code se banti hain (settings ke Widgets option se on/off), 2 per row -->
    <LinearLayout
        android:id="@+id/widgetArea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/pageGrid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never"
        android:paddingStart="8dp"
        android:paddingEnd="8dp" />
</LinearLayout>
